{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-file-system": "~58.0.13",
    "expo-print": "~58.0.8",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.20",
    "lucide-react-native": "^1.66.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --experimental-strip-types --test __tests__/**/*.test.ts",
    "build:apk": "NODE_OPTIONS=--no-network-family-autoselection eas build --platform android --profile production-apk",
    "build:preview": "NODE_OPTIONS=--no-network-family-autoselection eas build --platform android --profile preview",
    "update:preview": "NODE_OPTIONS=--no-network-family-autoselection eas update --channel preview",
    "update:prod": "NODE_OPTIONS=--no-network-family-autoselection eas update --channel production"
  },
  "private": true
}
