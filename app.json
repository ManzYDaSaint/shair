{
  "expo": {
    "name": "Shair",
    "slug": "shair",
    "owner": "nyangazies-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2A1017"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shair.ledger"
    },
    "android": {
      "package": "com.shair.ledger",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#2A1017"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/374ed1ff-274d-45cc-b9cd-2a5e283e1761",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 1000
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-file-system",
        {}
      ],
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "374ed1ff-274d-45cc-b9cd-2a5e283e1761"
      }
    }
  }
}
